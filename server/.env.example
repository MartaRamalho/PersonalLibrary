# Copy this file to `.env` (same folder) and fill in your key.
# Google Books API key — used only to fetch book descriptions (search + ratings
# come from Open Library, which needs no key). Optional but recommended: it
# raises the request quota and avoids occasional rate-limit errors.
# Get one at: https://console.cloud.google.com → APIs & Services → enable
# "Books API" → Credentials → Create credentials → API key.
GOOGLE_BOOKS_API_KEY=
